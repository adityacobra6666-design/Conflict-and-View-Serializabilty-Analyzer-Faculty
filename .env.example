# ==============================================================================
# Global Configuration Example - Conflict & View Serializability Analyzer
# ==============================================================================

# Backend Port (dynamically set by Render to $PORT)
PORT=8000

# Frontend URL for Backend CORS & OpenRouter Referer
FRONTEND_URL=https://conflict-and-view-analyzer.onrender.com

# Frontend API URL (Used by Vite during frontend build)
VITE_API_URL=https://conflict-and-view-analyzer-backend.onrender.com

# Database URL (SQLite default, or Render PostgreSQL for persistent storage)
DATABASE_URL=sqlite:///./sqlite.db

# Optional AI Server-Side Key for OCR Vision Fallback
# GEMINI_API_KEY=AIzaSy...
