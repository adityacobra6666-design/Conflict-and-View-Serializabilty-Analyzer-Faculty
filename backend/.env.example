# ==============================================================================
# Backend Configuration Example - Render Web Service / Local Development
# ==============================================================================

# Server Port (Render dynamically injects PORT; default is 8000)
PORT=8000

# Frontend URL(s) for CORS and OpenRouter HTTP-Referer identification
# In local development: http://localhost:5173 or http://localhost:5174
# In production on Render: set to your deployed Render Static Site URL
FRONTEND_URL=https://conflict-and-view-analyzer.onrender.com

# Optional comma-separated additional allowed CORS origins
# ALLOWED_ORIGINS=http://localhost:5173,https://mycustomdomain.com

# Database Connection URL
# Defaults to local SQLite (sqlite:///.../sqlite.db).
# NOTE: On Render Free Tier web services, storage is ephemeral.
# If you want persistent history across deploys/restarts, provision a Render PostgreSQL instance:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./sqlite.db

# Optional AI Vision Fallback (Server-Side)
# Note: AI Tutor in frontend uses client-side BYOK (Bring Your Own Key, e.g. OpenRouter).
# GEMINI_API_KEY is OPTIONAL: used exclusively as an AI vision fallback for OCR
# when local pytesseract OCR detects zero operations in an uploaded question image or PDF.
# GEMINI_API_KEY=AIzaSy...
