# ==============================================================================
# Frontend Configuration Example - Render Static Site / Local Development
# ==============================================================================

# Backend API Base URL
# In local development: leave empty to use the Vite dev server reverse proxy (/api -> http://localhost:8000)
# In production on Render: set to your deployed backend Render Web Service URL
# Example: https://conflict-and-view-analyzer-api.onrender.com
# (The frontend automatically appends /api exactly once)
VITE_API_URL=https://YOUR-BACKEND.onrender.com
